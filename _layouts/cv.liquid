---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
          title="Download PDF"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {% if page.cv_pdf %}
      <div class="cv-pdf-container" style="width: 100%; height: 100vh; margin-top: 1rem;">
        <iframe
          {% if page.cv_pdf contains '://' %}
            src="{{ page.cv_pdf }}"
          {% else %}
            src="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          width="100%"
          height="100%"
          style="border: 1px solid #ddd; border-radius: 4px;"
          title="CV PDF"
        >
          <p>Your browser does not support PDFs. <a
            {% if page.cv_pdf contains '://' %}
              href="{{ page.cv_pdf }}"
            {% else %}
              href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
            {% endif %}
          >Download the PDF</a> to view it.</p>
        </iframe>
      </div>
    {% endif %}
  </article>
</div>
